{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hyhunss/sg-semicon-us-expansion-plugin/skills/qualify-us-prospects/schema/qualified-prospects.schema.json",
  "title": "SG Semicon Qualified Prospects",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_name",
    "sme_name",
    "safe_sme_name",
    "generated_at",
    "source_capability_profile_path",
    "total_prospects_screened",
    "qualification_scope",
    "qualification_logic",
    "qualified_shortlist",
    "deprioritized_or_excluded",
    "recommended_next_steps"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0", "1.1.0", "1.2.0", "1.3.0", "1.4.0"]
    },
    "schema_name": {
      "type": "string",
      "const": "qualified_prospects"
    },
    "sme_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "safe_sme_name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_capability_profile_path": {
      "type": "string",
      "pattern": "^output/[a-z0-9]+(?:_[a-z0-9]+)*/01_capability_profile\\.md$"
    },
    "source_prospect_discovery_path": {
      "type": "string",
      "pattern": "^output/[a-z0-9]+(?:_[a-z0-9]+)*_prospects\\.(json|md)$"
    },
    "source_prospect_directory": {
      "type": "string",
      "pattern": "^output/[a-z0-9]+(?:_[a-z0-9]+)*/prospects$"
    },
    "total_prospects_screened": {
      "type": "integer",
      "minimum": 1,
      "description": "Total number of candidate prospect records screened from the Skill 2 library during qualification."
    },
    "qualification_scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "qualification_logic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sme_capabilities_used", "must_not_overclaim_caveats", "best_buyer_paths"],
      "properties": {
        "sme_capabilities_used": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 220
          }
        },
        "must_not_overclaim_caveats": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        },
        "best_buyer_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        }
      }
    },
    "sbf_engagement_recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contact_sbf", "primary_stage", "decision_rationale", "specific_request_to_sbf", "sme_preparation_required"],
      "properties": {
        "contact_sbf": {
          "type": "string",
          "enum": ["Contact SBF now", "Contact SBF after preparation", "Do not contact SBF yet"]
        },
        "primary_stage": {
          "type": "string",
          "enum": ["Learn", "Lead Generation", "Land", "Localize"]
        },
        "decision_rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "specific_request_to_sbf": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "sme_preparation_required": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    },
    "executive_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headline", "action_now", "strategic_routes", "critical_unknowns"],
      "properties": {
        "headline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "action_now": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["prospect", "why_now", "next_sbf_action"],
            "properties": {
              "prospect": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "why_now": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "next_sbf_action": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              }
            }
          }
        },
        "strategic_routes": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["prospect", "why_strategic"],
            "properties": {
              "prospect": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "why_strategic": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            }
          }
        },
        "critical_unknowns": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    },
    "qualified_shortlist": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "prospect",
          "classification",
          "best_buyer_path",
          "why_this_prospect",
          "timing_signal",
          "evidence_strength",
          "key_evidence",
          "score",
          "what_to_verify_next"
        ],
        "properties": {
          "prospect": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "classification": {
            "type": "string",
            "enum": ["Priority", "Watchlist", "Strategic"]
          },
          "engagement_role": {
            "type": "string",
            "enum": ["Commercial prospect", "Route-to-market partner", "Ecosystem connector"]
          },
          "us_cluster": {
            "type": "string",
            "enum": ["Central Texas", "Arizona", "New York", "California", "Other US"]
          },
          "recommended_sbf_stage": {
            "type": "string",
            "enum": ["Learn", "Lead Generation", "Land", "Localize"]
          },
          "recommended_sbf_action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "best_buyer_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "why_this_prospect": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "timing_signal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "evidence_strength": {
            "type": "string",
            "enum": ["Direct", "Strong inference", "Weak inference"]
          },
          "key_evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "evidence_role",
                "source_focus",
                "source_title",
                "source_type",
                "source_date",
                "url",
                "supported_claim",
                "evidence_excerpt"
              ],
              "properties": {
                "evidence_role": {
                  "type": "string",
                  "enum": ["Timing signal", "Capability fit", "Buyer path", "Accessibility", "Risk / caveat"]
                },
                "source_focus": {
                  "type": "string",
                  "enum": ["Project/timing-specific", "Capability/background", "Route/access", "Risk/caveat"]
                },
                "source_title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 180
                },
                "source_type": {
                  "type": "string",
                  "enum": [
                    "Company page",
                    "Press release",
                    "Government notice",
                    "Contractor project page",
                    "Industry article",
                    "Job posting",
                    "Other"
                  ]
                },
                "source_date": {
                  "type": "string",
                  "pattern": "^(\\d{4}(-\\d{2}){0,2}|Not stated)$"
                },
                "accessed_on": {
                  "type": "string",
                  "format": "date"
                },
                "url": {
                  "type": "string",
                  "pattern": "^https?://.+"
                },
                "supported_claim": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "evidence_excerpt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              }
            }
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20,
            "description": "Must equal the arithmetic sum of all six score_breakdown fields for schema version 1.3.0."
          },
          "score_breakdown": {
            "type": "object",
            "additionalProperties": false,
            "description": "Six rubric components whose arithmetic sum must equal score.",
            "required": [
              "capability_fit",
              "timing_urgency",
              "buyer_path_clarity",
              "accessibility_sbf_route",
              "priority_cluster_fit",
              "evidence_strength"
            ],
            "properties": {
              "capability_fit": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5
              },
              "timing_urgency": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              },
              "buyer_path_clarity": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              },
              "accessibility_sbf_route": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              },
              "priority_cluster_fit": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1
              },
              "evidence_strength": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2
              }
            }
          },
          "what_to_verify_next": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        }
      }
    },
    "deprioritized_or_excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prospect_or_group", "reason"],
        "properties": {
          "prospect_or_group": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "recommended_next_steps": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    }
  }
}
