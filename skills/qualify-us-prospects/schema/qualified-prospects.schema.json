{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hyhunss/sg-semicon-us-expansion-plugin/skills/qualify-us-prospects/schema/qualified-prospects.schema.json",
  "title": "SG Semicon Qualified Prospects",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_name",
    "sme_name",
    "safe_sme_name",
    "generated_at",
    "source_capability_profile_path",
    "source_prospect_discovery_path",
    "qualification_scope",
    "qualification_logic",
    "qualified_shortlist",
    "deprioritized_or_excluded",
    "recommended_next_steps"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "schema_name": {
      "type": "string",
      "const": "qualified_prospects"
    },
    "sme_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "safe_sme_name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_capability_profile_path": {
      "type": "string",
      "pattern": "^data/[a-z0-9]+(?:_[a-z0-9]+)*_capabilities\\.(json|md)$"
    },
    "source_prospect_discovery_path": {
      "type": "string",
      "pattern": "^data/[a-z0-9]+(?:_[a-z0-9]+)*_prospects\\.(json|md)$"
    },
    "qualification_scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "qualification_logic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sme_capabilities_used", "must_not_overclaim_caveats", "best_buyer_paths"],
      "properties": {
        "sme_capabilities_used": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 220
          }
        },
        "must_not_overclaim_caveats": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        },
        "best_buyer_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        }
      }
    },
    "qualified_shortlist": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "prospect",
          "classification",
          "best_buyer_path",
          "why_this_prospect",
          "timing_signal",
          "evidence_strength",
          "key_evidence",
          "score",
          "what_to_verify_next"
        ],
        "properties": {
          "prospect": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "classification": {
            "type": "string",
            "enum": ["Priority", "Watchlist", "Strategic"]
          },
          "best_buyer_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "why_this_prospect": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "timing_signal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "evidence_strength": {
            "type": "string",
            "enum": ["Direct", "Strong inference", "Weak inference"]
          },
          "key_evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "evidence_role",
                "source_focus",
                "source_title",
                "source_type",
                "source_date",
                "url",
                "supported_claim",
                "evidence_excerpt"
              ],
              "properties": {
                "evidence_role": {
                  "type": "string",
                  "enum": ["Timing signal", "Capability fit", "Buyer path", "Accessibility", "Risk / caveat"]
                },
                "source_focus": {
                  "type": "string",
                  "enum": ["Project/timing-specific", "Capability/background", "Route/access", "Risk/caveat"]
                },
                "source_title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 180
                },
                "source_type": {
                  "type": "string",
                  "enum": [
                    "Company page",
                    "Press release",
                    "Government notice",
                    "Contractor project page",
                    "Industry article",
                    "Job posting",
                    "Other"
                  ]
                },
                "source_date": {
                  "type": "string",
                  "pattern": "^(\\d{4}(-\\d{2}){0,2}|Not stated)$"
                },
                "url": {
                  "type": "string",
                  "pattern": "^https?://.+"
                },
                "supported_claim": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "evidence_excerpt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              }
            }
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20
          },
          "what_to_verify_next": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "classification": {
                  "const": "Priority"
                }
              },
              "required": ["classification"]
            },
            "then": {
              "properties": {
                "key_evidence": {
                  "allOf": [
                    {
                      "minItems": 3
                    },
                    {
                      "contains": {
                        "type": "object",
                        "properties": {
                          "evidence_role": {
                            "const": "Timing signal"
                          }
                        },
                        "required": ["evidence_role"]
                      }
                    },
                    {
                      "contains": {
                        "type": "object",
                        "properties": {
                          "evidence_role": {
                            "const": "Capability fit"
                          }
                        },
                        "required": ["evidence_role"]
                      }
                    },
                    {
                      "contains": {
                        "type": "object",
                        "properties": {
                          "evidence_role": {
                            "enum": ["Buyer path", "Accessibility"]
                          }
                        },
                        "required": ["evidence_role"]
                      }
                    },
                    {
                      "contains": {
                        "type": "object",
                        "properties": {
                          "source_focus": {
                            "const": "Project/timing-specific"
                          }
                        },
                        "required": ["source_focus"]
                      }
                    }
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "classification": {
                  "const": "Strategic"
                }
              },
              "required": ["classification"]
            },
            "then": {
              "properties": {
                "key_evidence": {
                  "allOf": [
                    {
                      "contains": {
                        "type": "object",
                        "properties": {
                          "evidence_role": {
                            "const": "Timing signal"
                          }
                        },
                        "required": ["evidence_role"]
                      }
                    },
                    {
                      "contains": {
                        "type": "object",
                        "properties": {
                          "evidence_role": {
                            "const": "Capability fit"
                          }
                        },
                        "required": ["evidence_role"]
                      }
                    },
                    {
                      "contains": {
                        "type": "object",
                        "properties": {
                          "evidence_role": {
                            "enum": ["Buyer path", "Risk / caveat"]
                          }
                        },
                        "required": ["evidence_role"]
                      }
                    }
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "classification": {
                  "const": "Watchlist"
                }
              },
              "required": ["classification"]
            },
            "then": {
              "properties": {
                "key_evidence": {
                  "allOf": [
                    {
                      "contains": {
                        "type": "object",
                        "properties": {
                          "evidence_role": {
                            "const": "Capability fit"
                          }
                        },
                        "required": ["evidence_role"]
                      }
                    },
                    {
                      "contains": {
                        "type": "object",
                        "properties": {
                          "evidence_role": {
                            "const": "Risk / caveat"
                          }
                        },
                        "required": ["evidence_role"]
                      }
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "deprioritized_or_excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prospect_or_group", "reason"],
        "properties": {
          "prospect_or_group": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "recommended_next_steps": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    }
  }
}
