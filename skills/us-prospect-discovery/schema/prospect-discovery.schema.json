{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hyhunss/sg-semicon-us-expansion-plugin/skills/us-prospect-discovery/schema/prospect-discovery.schema.json",
  "title": "SG Semicon Prospect Discovery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_name",
    "sme_name",
    "safe_sme_name",
    "generated_at",
    "source_capability_profile_path",
    "prospect_scope",
    "fit_rules",
    "search_rounds",
    "prospects",
    "exclusions_and_caveats",
    "recommended_next_analysis"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0", "1.1.0", "1.2.0"]
    },
    "schema_name": {
      "type": "string",
      "const": "prospect_discovery"
    },
    "sme_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "safe_sme_name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_capability_profile_path": {
      "type": "string",
      "pattern": "^data/[a-z0-9]+(?:_[a-z0-9]+)*_capabilities\\.(json|md)$"
    },
    "prospect_scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "search_term_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_supported_terms",
        "ai_suggested_terms",
        "user_added_terms",
        "user_removed_terms",
        "buyer_timing_terms",
        "confirmed_technical_terms",
        "confirmation_status"
      ],
      "properties": {
        "profile_supported_terms": {
          "$ref": "#/$defs/nonempty_term_list"
        },
        "ai_suggested_terms": {
          "$ref": "#/$defs/term_list"
        },
        "user_added_terms": {
          "$ref": "#/$defs/term_list"
        },
        "user_removed_terms": {
          "$ref": "#/$defs/term_list"
        },
        "buyer_timing_terms": {
          "$ref": "#/$defs/nonempty_term_list"
        },
        "confirmed_technical_terms": {
          "$ref": "#/$defs/nonempty_term_list"
        },
        "confirmation_status": {
          "type": "string",
          "const": "Confirmed by user"
        }
      }
    },
    "priority_clusters_searched": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["Central Texas", "Arizona", "New York", "California", "Other US"]
      }
    },
    "fit_rules": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "search_rounds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["round_number", "queries_tried", "reflection"],
        "properties": {
          "round_number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "queries_tried": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 180
            }
          },
          "diversity_check": {
            "type": "string"
          },
          "reflection": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          }
        }
      }
    },
    "prospects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "prospect",
          "prospect_type",
          "route_type",
          "matched_capability",
          "buying_trigger_or_context",
          "evidence_urls",
          "why_this_showed_up"
        ],
        "properties": {
          "prospect": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "prospect_type": {
            "type": "string",
            "enum": [
              "Fab",
              "OSAT",
              "Advanced packaging",
              "Equipment OEM",
              "EPC/EPCM",
              "Cleanroom contractor",
              "Systems integrator",
              "Materials",
              "Defense microelectronics",
              "Compound semiconductor",
              "Partner ecosystem",
              "Economic development organization",
              "Chamber / trade association",
              "University / research consortium",
              "Public-sector initiative",
              "Other"
            ]
          },
          "engagement_role": {
            "type": "string",
            "enum": ["Commercial prospect", "Route-to-market partner", "Ecosystem connector"]
          },
          "us_cluster": {
            "type": "string",
            "enum": ["Central Texas", "Arizona", "New York", "California", "Other US"]
          },
          "route_type": {
            "$ref": "#/$defs/route_type"
          },
          "matched_capability": {
            "type": "string",
            "minLength": 1,
            "maxLength": 220
          },
          "buying_trigger_or_context": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "evidence_urls": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^https?://.+"
            }
          },
          "why_this_showed_up": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "caveats": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            }
          }
        }
      }
    },
    "exclusions_and_caveats": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "recommended_next_analysis": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {"enum": ["1.1.0", "1.2.0"]}
        },
        "required": ["schema_version"]
      },
      "then": {
        "required": ["priority_clusters_searched"],
        "properties": {
          "prospects": {
            "items": {
              "required": ["engagement_role", "us_cluster"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {"const": "1.2.0"}
        },
        "required": ["schema_version"]
      },
      "then": {
        "required": ["search_term_plan"]
      }
    }
  ],
  "$defs": {
    "term_list": {
      "type": "array",
      "maxItems": 15,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "nonempty_term_list": {
      "allOf": [
        {"$ref": "#/$defs/term_list"},
        {"minItems": 1}
      ]
    },
    "route_type": {
      "type": "string",
      "enum": ["Direct owner", "Channel/EPC", "Partner ecosystem", "Watchlist"]
    }
  }
}
