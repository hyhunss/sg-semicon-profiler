{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hyhunss/sg-semicon-us-expansion-plugin/skills/us-prospect-discovery/schema/prospect-discovery.schema.json",
  "title": "SG Semicon Prospect Discovery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_name",
    "sme_name",
    "safe_sme_name",
    "generated_at",
    "source_capability_profile_path",
    "prospect_scope",
    "fit_rules",
    "search_rounds",
    "prospects",
    "exclusions_and_caveats",
    "recommended_next_analysis"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "schema_name": {
      "type": "string",
      "const": "prospect_discovery"
    },
    "sme_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "safe_sme_name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_capability_profile_path": {
      "type": "string",
      "pattern": "^data/[a-z0-9]+(?:_[a-z0-9]+)*_capabilities\\.(json|md)$"
    },
    "prospect_scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "fit_rules": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "search_rounds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["round_number", "queries_tried", "reflection"],
        "properties": {
          "round_number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "queries_tried": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 180
            }
          },
          "diversity_check": {
            "type": "string"
          },
          "reflection": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          }
        }
      }
    },
    "prospects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "prospect",
          "prospect_type",
          "route_type",
          "matched_capability",
          "buying_trigger_or_context",
          "evidence_urls",
          "why_this_showed_up"
        ],
        "properties": {
          "prospect": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "prospect_type": {
            "type": "string",
            "enum": [
              "Fab",
              "OSAT",
              "Advanced packaging",
              "Equipment OEM",
              "EPC/EPCM",
              "Cleanroom contractor",
              "Systems integrator",
              "Materials",
              "Defense microelectronics",
              "Compound semiconductor",
              "Partner ecosystem",
              "Other"
            ]
          },
          "route_type": {
            "$ref": "#/$defs/route_type"
          },
          "matched_capability": {
            "type": "string",
            "minLength": 1,
            "maxLength": 220
          },
          "buying_trigger_or_context": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "evidence_urls": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^https?://.+"
            }
          },
          "why_this_showed_up": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "caveats": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            }
          }
        }
      }
    },
    "exclusions_and_caveats": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "recommended_next_analysis": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    }
  },
  "$defs": {
    "route_type": {
      "type": "string",
      "enum": ["Direct owner", "Channel/EPC", "Partner ecosystem", "Watchlist"]
    }
  }
}
