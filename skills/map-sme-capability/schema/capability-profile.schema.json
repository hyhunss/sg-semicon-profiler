{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hyhunss/sg-semicon-us-expansion-plugin/skills/map-sme-capability/schema/capability-profile.schema.json",
  "title": "SG Semicon Capability Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_name",
    "sme_name",
    "safe_sme_name",
    "source_references",
    "generated_at",
    "core_capabilities",
    "evidence_notes",
    "smart_keyword_seeds",
    "caveats"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0", "1.1.0"]
    },
    "schema_name": {
      "type": "string",
      "const": "capability_profile"
    },
    "sme_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "safe_sme_name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "source_references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "sbf_scope_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "singapore_ownership_status",
        "sme_size_status",
        "supporting_industry_fit",
        "sbf_support_stage",
        "notes"
      ],
      "properties": {
        "singapore_ownership_status": {
          "type": "string",
          "enum": ["Confirmed", "Likely", "Unknown", "Does not meet"]
        },
        "sme_size_status": {
          "type": "string",
          "enum": ["Confirmed", "Likely", "Unknown", "Does not meet"]
        },
        "supporting_industry_fit": {
          "type": "string",
          "enum": ["In scope", "Adjacent", "Out of scope", "Unknown"]
        },
        "sbf_support_stage": {
          "type": "string",
          "enum": ["Learn", "Lead Generation", "Land", "Localize", "Unknown"]
        },
        "notes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        }
      }
    },
    "core_capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "confidence"],
        "properties": {
          "capability": {
            "type": "string",
            "minLength": 1,
            "maxLength": 220
          },
          "confidence": {
            "type": "string",
            "enum": ["High", "Medium", "Low"]
          }
        }
      }
    },
    "evidence_notes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["note", "source"],
        "properties": {
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "smart_keyword_seeds": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "keyword_seed"],
        "properties": {
          "label": {
            "type": "string",
            "enum": ["Procurement", "Production Ramp", "Tier 1 Collaboration", "Funding/New Facility", "Buyer Pain"]
          },
          "keyword_seed": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250
          }
        }
      }
    },
    "caveats": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 400
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {"const": "1.1.0"}
        },
        "required": ["schema_version"]
      },
      "then": {
        "required": ["sbf_scope_assessment"]
      }
    }
  ]
}
